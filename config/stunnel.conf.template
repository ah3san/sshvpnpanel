; =============================================================================
; Stunnel Configuration Template for SSH VPN Panel
; =============================================================================
; This is a template file. The panel will generate actual stunnel.conf
; based on configured tunnels and this template.
; =============================================================================

; Global settings
setuid = stunnel4
setgid = stunnel4

; PID file
pid = /var/run/stunnel4/stunnel4.pid

; Log file
output = /var/log/stunnel4/stunnel4.log

; Log level (0=emerg, 1=alert, 2=crit, 3=err, 4=warning, 5=notice, 6=info, 7=debug)
debug = 5

; Socket options
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1

; Compression (zlib)
; compression = zlib

; FIPS mode (requires FIPS-compatible OpenSSL)
; fips = yes

; =============================================================================
; [TUNNEL_NAME]
; Example SSH over SSL tunnel - Port 443 -> SSH Port 22
; =============================================================================
;
; [ssh-ssl]
; accept  = 0.0.0.0:443
; connect = 127.0.0.1:22
; cert    = /etc/sshvpnpanel/certs/server.crt
; key     = /etc/sshvpnpanel/certs/server.key
; CAfile  = /etc/sshvpnpanel/certs/ca.crt
; verify  = 2
; TIMEOUTclose = 0
; sslVersion = TLSv1.3
;
; =============================================================================
; Example SSH over SSL with SNI routing
; =============================================================================
;
; [sni-router]
; accept  = 0.0.0.0:443
; protocol = sni
;
; [ssh-via-sni]
; accept  = 127.0.0.1:8022
; connect = 127.0.0.1:22
; cert    = /etc/sshvpnpanel/certs/ssh.example.com.crt
; key     = /etc/sshvpnpanel/certs/ssh.example.com.key
; sniNames = ssh.example.com
;
; [https-via-sni]
; accept  = 127.0.0.1:8443
; connect = 127.0.0.1:80
; cert    = /etc/sshvpnpanel/certs/www.example.com.crt
; key     = /etc/sshvpnpanel/certs/www.example.com.key
; sniNames = www.example.com
;
; =============================================================================
; Example Websocket tunnel
; =============================================================================
;
; [websocket-ssl]
; accept  = 0.0.0.0:8080
; connect = 127.0.0.1:22
; cert    = /etc/sshvpnpanel/certs/server.crt
; key     = /etc/sshvpnpanel/certs/server.key
; =============================================================================
